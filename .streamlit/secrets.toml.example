# Streamlit Community Cloud にデプロイする際、
# このファイルの内容を Streamlit Cloud の Secrets 設定画面に貼り付ける。
# ローカルでは不要（dashboard_sa_key.json を自動で読む）。

[firebase_sa]
type = "service_account"
project_id = "ai-agent-dashboard-5810b"
private_key_id = "YOUR_KEY_ID"
private_key = "-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY\n-----END RSA PRIVATE KEY-----\n"
client_email = "dashboard-deploy@ai-agent-dashboard-5810b.iam.gserviceaccount.com"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CERT_URL"
